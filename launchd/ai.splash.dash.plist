<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.splash.dash</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>SPLASH_API_KEY="$(plutil -extract EnvironmentVariables.SPLASH_API_KEY raw $HOME/Library/LaunchAgents/ai.splash.serve.plist)"; cd $HOME/Projects/splash-dashboard &amp;&amp; exec /usr/bin/python3 dash.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/honu/Library/Logs/splash/dash.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/honu/Library/Logs/splash/dash.err.log</string>
</dict>
</plist>
